@page "/movie/{Id:int}"
@using System.Net
@inject TMDBServiceAccess TmdbService
@inject WishlistService Wishlist

<PageTitle>@(movie?.Title ?? "Movie") · MovieDB</PageTitle>

<div class="movie-page">
    @if (isLoading)
    {
        <p class="state-message">Loading movie…</p>
    }
    else if (notFound)
    {
        <h1>Movie not found</h1>
        <p class="state-message">We couldn't find that movie. <a href="/">Back to genres</a>.</p>
    }
    else if (hasError || movie is null)
    {
        <p class="state-message">
            Couldn't load this movie.
            <button type="button" class="retry-button" @onclick="LoadAsync">Try again</button>
        </p>
    }
    else
    {
        @if (backdropUrl is not null)
        {
            <div class="movie-backdrop" style="background-image: url('@backdropUrl');" aria-hidden="true"></div>
        }
        
        <header class="movie-header">
            <h1>@movie.Title</h1>
            <span class="movie-year-separator" aria-hidden="true">|</span>
            <span class="movie-year">@ReleaseYear</span>
        </header>

        <div class="movie-main">
            <div class="movie-poster-wrap">
                @if (!string.IsNullOrEmpty(movie.PosterPath))
                {
                    <img class="movie-poster"
                         src="@($"https://image.tmdb.org/t/p/w500{movie.PosterPath}")"
                         alt="@($"{movie.Title} poster")"
                         loading="lazy" />
                }
                else
                {
                    <div class="movie-poster movie-poster-placeholder" aria-hidden="true">No poster</div>
                }

                @if (trailer is not null)
                {
                    <button type="button" class="trailer-button"
                            @onclick="() => showTrailer = !showTrailer"
                            aria-expanded="@showTrailer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                             fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z" />
                        </svg>
                        @(showTrailer ? "Hide trailer" : "Watch trailer")
                    </button>

                    @if (showTrailer)
                    {
                        <div class="trailer-frame">
                            <iframe src="@($"https://www.youtube-nocookie.com/embed/{trailer.Key}?rel=0")"
                                    title="@($"{movie.Title} trailer")"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen
                                    loading="lazy"></iframe>
                        </div>
                    }
                }

                <button type="button"
                        class="wishlist-button @(IsWishlisted ? "is-active" : null)"
                        @onclick="ToggleWishlist">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16"
                         fill="currentColor" aria-hidden="true">
                        @if (IsWishlisted)
                        {
                            <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5V2z" />
                        }
                        else
                        {
                            <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5V2zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1H4z" />
                        }
                    </svg>
                    @(IsWishlisted ? "Remove from wishlist" : "Add to wishlist")
                </button>
            </div>

            <div class="movie-details">
                <section class="movie-section">
                    <h2 class="section-label">Genres</h2>
                    @if (movie.Genres.Count > 0)
                    {
                        <div class="genre-chips">
                            @foreach (var genre in movie.Genres)
                            {
                                <a class="genre-chip" href="movies?genre=@genre.Id">@genre.Name</a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="muted">No genres listed.</p>
                    }
                </section>

                <section class="movie-section">
                    <h2 class="section-label">Director@(directors.Count > 1 ? "s" : "")</h2>
                    <p class="directors">
                        @(directors.Count > 0
                            ? string.Join(", ", directors.Select(d => d.Name))
                            : "Unknown")
                    </p>
                </section>

                <section class="movie-section">
                    <h2 class="section-label">Overview</h2>
                    <p class="overview">
                        @(string.IsNullOrWhiteSpace(movie.Overview) ? "No overview available." : movie.Overview)
                    </p>
                </section>
            </div>
        </div>

        <section class="credits">
            <h2 class="credits-heading">Cast</h2>
            @if (cast.Count > 0)
            {
                <ul class="cast-grid">
                    @foreach (var actor in cast)
                    {
                        <li class="cast-item">
                            <span class="cast-name">@actor.Name</span>
                            @if (!string.IsNullOrWhiteSpace(actor.Character))
                            {
                                <span class="cast-character">as @actor.Character</span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">No cast info.</p>
            }
        </section>

        <section class="credits">
            <h2 class="credits-heading">Crew</h2>
            @if (crewGroups.Count > 0)
            {
                @foreach (var group in crewGroups)
                {
                    <div class="crew-group">
                        <h3>@group.Key</h3>
                        <ul class="crew-list">
                            @foreach (var member in group.OrderBy(c => c.Name))
                            {
                                <li class="crew-item">@member.Name <span class="crew-job">— @member.Job</span></li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <p class="muted">No crew info.</p>
            }
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private MovieDTO? movie;
    private List<CastDTO> cast = [];
    private List<CrewDTO> directors = [];
    private List<IGrouping<string, CrewDTO>> crewGroups = [];
    private bool isLoading = true;
    private bool hasError;
    private bool notFound;
    private string? backdropUrl;

    private bool IsWishlisted => movie is not null && Wishlist.Contains(movie.Id);

    private VideoDTO? trailer;
    private bool showTrailer;

    private string ReleaseYear =>
        movie is null
            ? ""
            : movie.ReleaseDate.Length >= 4
                ? movie.ReleaseDate[..4]
                : "—";

    protected override async Task OnParametersSetAsync()
    {
        // Skip the prerender pass; the interactive pass does the real fetch once.
        if (!RendererInfo.IsInteractive)
            return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        hasError = false;
        notFound = false;
        backdropUrl = null;
        trailer = null;
        showTrailer = false;

        try
        {
            var movieTask = TmdbService.GetMovieByIdAsync(Id);
            var creditsTask = TmdbService.GetMovieCreditsAsync(Id);
            var videosTask = TmdbService.GetMovieVideosAsync(Id);

            await Task.WhenAll(movieTask, creditsTask, videosTask);

            movie = await movieTask;
            var credits = await creditsTask;

            if (movie is null)
            {
                notFound = true;
                return;
            }

            trailer = PickTrailer(await videosTask);

            cast = credits?.Cast.OrderBy(c => c.Order).ToList() ?? [];
            directors = credits?.Crew.Where(c => c.Job == "Director").ToList() ?? [];
            crewGroups = credits?.Crew
                .GroupBy(c => c.Department)
                .OrderBy(g => g.Key)
                .ToList() ?? [];

            backdropUrl = string.IsNullOrEmpty(movie.BackdropPath)
            ? null
            : $"https://image.tmdb.org/t/p/w1280{movie.BackdropPath}";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            notFound = true;
        }
        catch (HttpRequestException)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static VideoDTO? PickTrailer(IReadOnlyCollection<VideoDTO> videos)
    {
        var youTube = videos
            .Where(v => v.Site == "YouTube" && !string.IsNullOrWhiteSpace(v.Key))
            .ToList();

        if (youTube.Count == 0)
            return null;

        static IEnumerable<VideoDTO> Preferred(IEnumerable<VideoDTO> source) =>
            source
                .OrderByDescending(v => v.Official)
                .ThenByDescending(v => v.Language == "en")
                .ThenByDescending(v => v.PublishedAt);

        return Preferred(youTube.Where(v => v.Type == "Trailer")).FirstOrDefault()
            ?? Preferred(youTube.Where(v => v.Type == "Teaser")).FirstOrDefault()
            ?? Preferred(youTube).FirstOrDefault();
    }

    private void ToggleWishlist()
    {
        if (movie is not null)
            Wishlist.Toggle(movie.Id);
    }
}