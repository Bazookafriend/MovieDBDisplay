@inject TMDBServiceAccess TmdbService

<header class="top-bar">
    <div class="top-bar-inner">
        <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">🎬</span>
            <span class="brand-name">Movie<span class="brand-accent">DB</span><span class="brand-name"> Display</span></span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />
        <label for="nav-toggle" class="nav-toggle-button" aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <nav class="nav-links" onclick="document.getElementById('nav-toggle').checked = false">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>

            <div class="nav-dropdown">
                <span class="nav-link nav-dropdown-toggle" tabindex="0" role="button" aria-haspopup="true">
                    Genres
                    <span class="nav-caret" aria-hidden="true"></span>
                </span>

                <ul class="nav-dropdown-menu">
                    @foreach (var genre in genres)
                    {
                        <li>
                            <a class="nav-dropdown-item" href="movies?genre=@genre.Id">@genre.Name</a>
                        </li>
                    }
                </ul>
            </div>

            <NavLink class="nav-link" href="wishlist">Wishlist</NavLink>
        </nav>
    </div>
</header>

@code {
    private List<GenreDTO> genres = [];

    protected override async Task OnInitializedAsync()
    {
        // Prerendering would fetch genres and then fetch again when the circuit starts.
        if (!RendererInfo.IsInteractive)
            return;

        try
        {
            genres = await TmdbService.GetAllGenresAsync();
        }
        catch (HttpRequestException)
        {
            genres = [];
        }
    }
}