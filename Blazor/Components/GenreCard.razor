@inject TMDBServiceAccess TmdbService

<section class="genre-card">
    <header class="genre-card-header">
        <h3 class="genre-title">
            <a href="movies?genre=@Genre.Id">@Genre.Name</a>
        </h3>
        @if (moviePage is not null)
        {
            <span class="genre-count">@moviePage.TotalCountLabel</span>
        }
    </header>

    @if (isLoading)
    {
        <div class="movie-row">
            @for (var i = 0; i < 3; i++)
            {
                <div class="movie-skeleton"></div>
            }
        </div>
    }
    else if (hasError)
    {
        <p class="genre-message">Couldn't load movies for this genre.</p>
    }
    else if (moviePage is null || moviePage.Results.Count == 0)
    {
        <p class="genre-message">No movies found for this genre.</p>
    }
    else
    {
        <div class="movie-row">
            @foreach (var movie in VisibleMovies)
            {
                <MovieCard Movie="movie" @key="movie.Id" />
            }
        </div>

        @if (moviePage.Results.Count > 3)
        {
            <button type="button" class="load-more" @onclick="LoadMore">Load more</button>
        }
    }
</section>

@code {
    [Parameter, EditorRequired]
    public GenreDTO Genre { get; set; } = default!;

    private MovieListPageDTO? moviePage;
    private int offset;
    private bool isLoading = true;
    private bool hasError;

    private IEnumerable<MovieDTO> VisibleMovies =>
        moviePage is null ? [] : moviePage.Results.Skip(offset).Take(3);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            moviePage = await TmdbService.GetMoviesByGenreAsync(Genre.Id);
        }
        catch (HttpRequestException)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void LoadMore()
    {
        if (moviePage is null || moviePage.Results.Count == 0)
            return;

        offset += 3;

        if (offset >= moviePage.Results.Count)
            offset = 0;
    }
}