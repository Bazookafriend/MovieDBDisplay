@inject WishlistService Wishlist
@implements IDisposable

<article class="movie-card">
    <div class="movie-poster-wrap">
        <a class="movie-poster-link" href="movie/@Movie.Id" aria-label="@($"{Movie.Title} details")">
            @if (!string.IsNullOrEmpty(Movie.PosterPath))
            {
                <img class="movie-poster"
                     src="@($"https://image.tmdb.org/t/p/w342{Movie.PosterPath}")"
                     alt=""
                     loading="lazy" />
            }
            else
            {
                <div class="movie-poster movie-poster-empty" aria-hidden="true">
                    <span>@Movie.Title</span>
                </div>
            }
        </a>

        <button type="button"
                class="wishlist-toggle @(IsWishlisted ? "is-active" : null)"
                @onclick="ToggleWishlist"
                title="@(IsWishlisted ? "Remove from wishlist" : "Add to wishlist")"
                aria-label="@(IsWishlisted ? "Remove from wishlist" : "Add to wishlist")">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16"
                 fill="currentColor" aria-hidden="true">
                @if (IsWishlisted)
                {
                    <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5V2z" />
                }
                else
                {
                    <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5V2zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1H4z" />
                }
            </svg>
        </button>
    </div>

    <div class="movie-info">
        <h4 class="movie-title"><a href="movie/@Movie.Id">@Movie.Title</a></h4>
        <span class="movie-year">@ReleaseYear</span>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public MovieDTO Movie { get; set; } = default!;

    private bool IsWishlisted => Wishlist.Contains(Movie.Id);

    private string ReleaseYear =>
        Movie.ReleaseDate.Length >= 4 ? Movie.ReleaseDate[..4] : "—";

    protected override void OnInitialized()
    {
        Wishlist.Changed += OnWishlistChanged;
    }

    private void OnWishlistChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleWishlist() => Wishlist.Toggle(Movie.Id);

    public void Dispose() => Wishlist.Changed -= OnWishlistChanged;
}